import QmlProject

// Qt Design Studio project for the headunit UI (made for Design Studio 4.8).
// Open this file in Design Studio. It runs on the demo data of qml/Sim.qml (as ./r80 demo);
// no services or D-Bus needed. run.py and ./r80 do not use this file.
Project {
    mainFile: "qml/main.qml"
    // demo stand-ins for the R80.Backend singletons, so Sim.qml runs on demo data
    importPaths: [ "qml-demo" ]
    mainUiFile: "qml/HomeScreen.qml"

    QmlFiles {
        directory: "qml"
    }

    Files {
        filter: "qmldir"
        directory: "qml"
    }

    FontFiles {
        filter: "*.ttf;*.otf"
        directory: "fonts"
    }

    Environment {
        QT_LOGGING_RULES: "qt.qml.connections=false"
        QT_ENABLE_HIGHDPI_SCALING: "0"
    }

    qt6Project: true

    /* List of plugin directories passed to QML runtime */
    importPaths: [ "qml" ]

    qdsVersion: "4.8"

    quickVersion: "6.8"

    widgetApp: false

    multilanguageSupport: false
    supportedLanguages: ["en"]
    primaryLanguage: "en"
}
