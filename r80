#!/usr/bin/env bash
# R80 headunit: one entry point for the three run modes.
#
#   ./r80 demo                         the UI with fake data (no services, no D-Bus)
#   ./r80 demo screenshots [DIR]       every screen to PNG (default: docs/screenshots)
#
#   ./r80 virtual <command>            the headunit on this PC, BoAt restbus and tests (dev/hu-virtual.sh):
#                                      up | drive | restbus | panel | phone | phonepanel | tunnel | ui | test | status | logs | down
#
#   ./r80 bundle [--out DIR] [--key K]  a signed update file of the HU software (ci/make_bundle.py;
#                                      default key: the development key, docs/bench-pi.md)
#
#   ./r80 bench <command>              the Raspberry Pi bench (docs/bench-pi.md)
#     on the Pi:  install [--desktop] [PC_IP]   install the systemd units for this checkout
#                 start | stop | restart        the HU (the desktop unit if installed, else the kiosk unit)
#                 status | logs                 unit status, follow the service logs
#                 update                        git pull, then restart the HU
#                 run-from checkout|release     start this checkout, or an installed release (updates, D12)
#                 run                           the kiosk in the foreground (one session bus)
#                 measure [--restart]           start-up times and memory as a report (bench/pi/measure.py)
#     on the PC:  rbs [panel|drive|stop]        the rest of the car for the Pi: buses, BoAt gateway, CAN tunnel
#                                               (PI_IP) and the restbus, with the tester panel (default) or
#                                               the drive cycle; no HU on the PC (the Pi is the HU); the panel's
#                                               knob and keys go to the Pi's MCU emulator (SSH). stop: all down
#                 tunnel                        CAN tunnel to the Pi (PI_IP; virtual up/drive start it too)
#                 share-internet <if> [<net>]   share this PC's internet with the Pi on the cable
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PY="${R80_PYTHON:-python3}"

usage() { sed -n '2,/^set /p' "${BASH_SOURCE[0]}" | sed -e '$d' -e 's/^# \{0,1\}//'; exit "${1:-0}"; }

hu_unit() {  # the HU unit this Pi uses: the desktop one (user) when installed, else the kiosk one
  if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/r80-hu-desktop.service" ]]; then
    echo user r80-hu-desktop
  else
    echo system r80-hu
  fi
}

hu_ctl() {  # start|stop|restart|status [options]
  read -r scope unit < <(hu_unit)
  if [[ $scope == user ]]; then systemctl --user "$@" "$unit"; else sudo systemctl "$@" "$unit"; fi
}

RELEASES="${R80_RELEASES:-${XDG_DATA_HOME:-$HOME/.local/share}/r80/releases}"
RUN_FROM_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/r80/run-from"

bench() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    install) exec "$REPO/bench/pi/install-units.sh" "$@" ;;
    start|stop|restart) hu_ctl "$cmd" ;;
    status) hu_ctl status --no-pager || true; systemctl status r80-can --no-pager || true ;;
    logs) exec tail -n 20 -F /tmp/r80-*.log ;;
    update)
      git -C "$REPO" pull --ff-only && hu_ctl restart
      [[ "$(cat "$RUN_FROM_FILE" 2>/dev/null)" == checkout || ! -L "$RELEASES/current" ]] \
        || echo "note: the HU starts the installed release $(readlink "$RELEASES/current"), not this checkout (./r80 bench run-from checkout)" ;;
    run-from)
      case "${1:-}" in
        checkout|release) mkdir -p "$(dirname "$RUN_FROM_FILE")" && echo "$1" >"$RUN_FROM_FILE" && hu_ctl restart ;;
        "") echo "starts: $(cat "$RUN_FROM_FILE" 2>/dev/null || echo release) (release if one is installed in $RELEASES)" ;;
        *) echo "run-from checkout|release" >&2; exit 2 ;;
      esac ;;
    run) exec dbus-run-session -- "$REPO/bench/pi/r80-kiosk.sh" ;;
    measure) exec "$PY" "$REPO/bench/pi/measure.py" "$@" ;;
    rbs)
      local how="${1:-panel}"
      case "$how" in
        panel) HU_DUT=external "$REPO/dev/hu-virtual.sh" up && "$REPO/dev/hu-virtual.sh" mcufwd \
                 && exec "$REPO/dev/hu-virtual.sh" panel ;;
        drive) HU_DUT=external "$REPO/dev/hu-virtual.sh" drive && exec "$REPO/dev/hu-virtual.sh" mcufwd ;;
        stop) exec "$REPO/dev/hu-virtual.sh" down ;;
        *) echo "rbs: panel, drive or stop, not '$how'" >&2; exit 2 ;;
      esac ;;
    tunnel) exec "$REPO/dev/hu-virtual.sh" tunnel ;;
    share-internet) exec "$REPO/bench/pi/pc-share-internet.sh" "$@" ;;
    *) echo "unknown bench command: '$cmd'" >&2; usage 2 ;;
  esac
}

mode="${1:-}"; shift || true
case "$mode" in
  demo)
    case "${1:-}" in
      "") exec "$PY" "$REPO/hu/ui/run.py" --demo ;;
      screenshots) exec "$PY" "$REPO/hu/ui/run.py" --screenshots "${2:-$REPO/docs/screenshots}" ;;
      *) exec "$PY" "$REPO/hu/ui/run.py" --demo "$@" ;;    # e.g. ./r80 demo --fullscreen
    esac ;;
  virtual) [[ $# -gt 0 ]] || usage 2; exec "$REPO/dev/hu-virtual.sh" "$@" ;;
  bench) bench "$@" ;;
  bundle) exec "$PY" "$REPO/ci/make_bundle.py" "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "unknown mode: '$mode'" >&2; usage 2 ;;
esac
