{
  "schema_version": "1.0",
  "name": "r80-hu-smoke",
  "version": "0.1",
  "description": "Smoke tests of the virtual R80 headunit against the R80 test DBC. Run from hu-virtual/ with the env up and no restbus node running: ./hu-virtual.sh test",
  "environment_config": "env_hu_virtual.json",
  "tests": [
    { "id": "TC_HU_001", "name": "Signal path CAN -> MCU -> D-Bus", "file": "python3 tests/test_signal_path.py", "timeout_s": 20 },
    { "id": "TC_HU_002", "name": "Missing message flagged stale", "file": "python3 tests/test_signal_timeout.py", "timeout_s": 20 },
    { "id": "TC_HU_003", "name": "Power states and shutdown handshake", "file": "python3 tests/test_power.py", "timeout_s": 30 },
    { "id": "TC_HU_004", "name": "Day/night dimming", "file": "python3 tests/test_dimming.py", "timeout_s": 20 },
    { "id": "TC_HU_005", "name": "Knob and button events", "file": "python3 tests/test_inputs.py", "timeout_s": 20 },
    { "id": "TC_HU_006", "name": "Listen-only on Motor and Comfort", "file": "python3 tests/test_listen_only.py", "timeout_s": 20 },
    { "id": "TC_HU_007", "name": "Media play / pause status", "file": "python3 tests/test_media_playback.py", "timeout_s": 30 },
    { "id": "TC_HU_008", "name": "Media track navigation", "file": "python3 tests/test_media_tracks.py", "timeout_s": 40 },
    { "id": "TC_HU_009", "name": "Audio volume and mute reach the player", "file": "python3 tests/test_audio_volume.py", "timeout_s": 40 },
    { "id": "TC_HU_010", "name": "Audio volumes remembered, master capped at start", "file": "python3 tests/test_audio_state.py", "timeout_s": 20 },
    { "id": "TC_HU_011", "name": "Navigation prompt ducks the music", "file": "python3 tests/test_audio_prompt.py", "timeout_s": 30 },
    { "id": "TC_HU_012", "name": "Call pauses media and silences radio", "file": "python3 tests/test_audio_call.py", "timeout_s": 30 },
    { "id": "TC_HU_013", "name": "Volume keys ignored while the HU is off", "file": "python3 tests/test_audio_power.py", "timeout_s": 40 },
    { "id": "TC_HU_014", "name": "Warning threshold, debounce, hysteresis, acknowledge", "file": "python3 tests/test_warn_threshold.py", "timeout_s": 60 },
    { "id": "TC_HU_015", "name": "Fast pressure drop is a critical warning", "file": "python3 tests/test_warn_rate.py", "timeout_s": 60 },
    { "id": "TC_HU_016", "name": "Missing data warning, none while the HU is off", "file": "python3 tests/test_warn_missing.py", "timeout_s": 40 },
    { "id": "TC_HU_017", "name": "Warning chimes, ducking, warning audible when muted", "file": "python3 tests/test_warn_chime.py", "timeout_s": 60 },
    { "id": "TC_HU_018", "name": "Trip computer from odometer and speed", "file": "python3 tests/test_trip_live.py", "timeout_s": 60 },
    { "id": "TC_HU_019", "name": "Trip state file and auto-reset after 2 h off", "file": "python3 tests/test_trip_state.py", "timeout_s": 30 },
    { "id": "TC_HU_020", "name": "Companion link protocol", "file": "python3 tests/test_companion_link.py", "timeout_s": 20 },
    { "id": "TC_HU_021", "name": "Navigation guidance from the phone", "file": "python3 tests/test_nav_guidance.py", "timeout_s": 40 },
    { "id": "TC_HU_022", "name": "Navigation: phone link loss and reconnect", "file": "python3 tests/test_nav_link_loss.py", "timeout_s": 60 },
    { "id": "TC_HU_023", "name": "Navigation: the phone over Bluetooth (BlueZ stand-in)", "file": "python3 tests/test_nav_bluetooth.py", "timeout_s": 40 }
  ]
}
