import QmlProject

// Qt Design Studio project for the UI mockup (made for Design Studio 4.8).
// Open this file in Design Studio. It uses the simulated data from qml/Sim.qml;
// no D-Bus or hu-virtual needed. run.py and hu-virtual do not use this file.
Project {
    mainFile: "qml/main.qml"
    mainUiFile: "qml/HomeScreen.qml"

    QmlFiles {
        directory: "qml"
    }

    ImageFiles {
        directory: "docs"
    }

    ImageFiles {
        directory: "screenshots"
    }

    Files {
        filter: "qmldir"
        directory: "qml"
    }

    FontFiles {
        filter: "*.ttf;*.otf"
        directory: "fonts"
    }

    Environment {
        QT_LOGGING_RULES: "qt.qml.connections=false"
        QT_ENABLE_HIGHDPI_SCALING: "0"
    }

    qt6Project: true

    /* List of plugin directories passed to QML runtime */
    importPaths: [ "qml" ]

    qdsVersion: "4.8"

    quickVersion: "6.8"

    widgetApp: false

    multilanguageSupport: false
    supportedLanguages: ["en"]
    primaryLanguage: "en"
}
