# Template (user unit): install-units.sh --desktop fills in @REPO@ and installs it to
# ~/.config/systemd/user/. The HU on the desktop instead of eglfs: all services plus the UI
# full screen on Wayland, so it shows over VNC on a bench without a monitor.
# Started by the desktop's autostart (r80-hu-desktop.desktop), not by default.target:
# it needs the Wayland session.
[Unit]
Description=R80 headunit on the desktop (Wayland, full screen)

[Service]
Environment=QT_QPA_PLATFORM=wayland R80_REPO=@REPO@
# hu-sysd restarts the HU this way for an update ("Restart now") or a rollback
Environment="R80_RESTART=systemctl --user restart --no-block r80-hu-desktop.service"
ExecStart=/usr/bin/dbus-run-session -- @REPO@/bench/pi/r80-kiosk.sh
Restart=on-failure
RestartSec=3
